<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ShaderWorkingDirectory>$(ProjectDir)shaders</ShaderWorkingDirectory>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds the tool first, but doesn't reference it as a library -->
    <ProjectReference Include="../RenderDocIntegration/RenderDocIntegration.csproj" />
    <ProjectReference Include="..\Tools\ShaderBuild\ShaderBuild.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <Optimize>true</Optimize>
    <StripSymbols>true</StripSymbols>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>

    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <OptimizationPreference>Size</OptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <IlcTrimMetadata>true</IlcTrimMetadata>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Msdfgen.Core" />
    <ProjectReference Include="../CoreManager/CoreManager.csproj" />
    <ProjectReference Include="../GraphicsCore/GraphicsCore.csproj" />
    <ProjectReference Include="../HTMLParser/HTMLParser.csproj" />
    <ProjectReference Include="../PrimitiveCore/PrimitiveCore.csproj" />
    <ProjectReference Include="../Renderer/Renderer.csproj" />
    <ProjectReference Include="../SpeedScopeTrace/SpeedScopeTrace.csproj" />
    <ProjectReference Include="../SvgLoader/SvgLoader.csproj" />
    <ProjectReference Include="../TextCore/TextCore.csproj" />
    <ProjectReference Include="../TextureCore/TextureCore.csproj" />
    <ProjectReference Include="../Units/Units.csproj" />
    <ProjectReference Include="../VulkanManager/VulkanManager.csproj" />
    <ProjectReference Include="..\InstanceFinderCore\InstanceFinderCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input.Sdl" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.23.0" />
    <PackageReference Include="Slangc.NET" Version="2026.7.0" />
    <PackageReference Include="SpaceWizards.SharpFont" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="BrowserWindow/" />
    <!-- <None Update="shaders/Compiled/*" CopyToOutputDirectory="PreserveNewest" /> -->
    <None Update="textures/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="models/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="textures/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CompileShaders" BeforeTargets="Build">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="compile.bat"
      WorkingDirectory="$(ShaderWorkingDirectory)" />

    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="bash compile.sh"
      WorkingDirectory="$(ShaderWorkingDirectory)" />
  </Target>


  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated/**/*.cs" />
    <ProjectReference Include="../Tools/AutoLoad.Generator/AutoLoad.Generator.csproj"
      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CollectShaders" AfterTargets="Build">

    <!-- Ask every referenced project for its compiled shaders -->
    <MSBuild
      Projects="@(ProjectReference)"
      Targets="GetCompiledShaders"
      BuildInParallel="true"
      SkipNonexistentTargets="true">

      <Output
        TaskParameter="TargetOutputs"
        ItemName="_ReferencedShaders" />

    </MSBuild>

    <MakeDir Directories="$(OutDir)Shaders"
      Condition="'@(_ReferencedShaders)' != ''" />

    <Copy
      SourceFiles="@(_ReferencedShaders)"
      DestinationFiles="@(_ReferencedShaders->'$(OutDir)Shaders/%(Library)/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_ReferencedShaders)' != ''" />

    <Message Importance="high"
      Text="Collected shaders: @(_ReferencedShaders)" />

  </Target>

  <Target Name="CollectShadersForPublish"
    AfterTargets="Publish"
    DependsOnTargets="CollectShaders">

    <MakeDir
      Directories="$(PublishDir)Shaders"
      Condition="'@(_ReferencedShaders)' != ''" />

    <Copy
      SourceFiles="@(_ReferencedShaders)"
      DestinationFiles="@(_ReferencedShaders->'$(PublishDir)Shaders/%(Library)/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_ReferencedShaders)' != ''" />

    <Message
      Importance="high"
      Text="Published shaders to: $(PublishDir)Shaders" />

  </Target>
</Project>