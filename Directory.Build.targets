<Project>
    <PropertyGroup>
        <ShaderProject>$(MSBuildThisFileDirectory)/Tools/ShaderBuild/ShaderBuild.csproj</ShaderProject>
        <ShaderLibrary>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)',
            '$(IntermediateOutputPath)', 'shaders'))</ShaderLibrary>
    </PropertyGroup>

    <Target Name="CompileShaders"
        BeforeTargets="CoreCompile"
        Condition="'$(MSBuildProjectName)' != 'ShaderBuild' and '$(Shaders)' != ''">

        <MSBuild Projects="$(ShaderProject)"
            Targets="Build"
            Properties="Configuration=$(Configuration);Platform=$(Platform)" />

        <PropertyGroup>
            <ShaderTool>$(MSBuildProjectDirectory)/../Tools/ShaderBuild/bin/$(Configuration)/net10.0/ShaderBuild.dll</ShaderTool>
        </PropertyGroup>

        <Error Condition="!Exists('$(ShaderTool)')" Text="Shader compiler not found: $(ShaderTool)" />

        <MakeDir Directories="$(ShaderLibrary)" />

        <Message Importance="high" Text="Compiling shaders for $(MSBuildProjectName): $(ShaderLibrary)" />

        <Exec
            Command="dotnet &quot;$(ShaderTool)&quot; &quot;$(MSBuildProjectDirectory)/$(Shaders)&quot; &quot;$(ShaderLibrary)&quot;"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            ConsoleToMSBuild="true" StandardOutputImportance="high" StandardErrorImportance="high" />

        <ItemGroup>
            <CompiledShader Include="$(ShaderLibrary)**/*.spv" />
        </ItemGroup>

        <Message Importance="high" Text="Found shaders: @(CompiledShader)" />
    </Target>
    <Target Name="GetCompiledShaders"
            Returns="@(_ExportedShaders)">

        <ItemGroup>
            <_ExportedShaders Include="$(ShaderLibrary)**/*.spv" Condition="Exists('$(ShaderLibrary)')">
                <Library>$(MSBuildProjectName)</Library>
            </_ExportedShaders>
        </ItemGroup>
    </Target>
</Project>