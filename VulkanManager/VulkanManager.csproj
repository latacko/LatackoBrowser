<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>

    <UseIntegratedGPU>true</UseIntegratedGPU>
    <UseDiscreteGpu>true</UseDiscreteGpu>

    <_GpuConstants Condition="'$(UseIntegratedGPU)' == 'true'">USE_INTEGRATED_GPU</_GpuConstants>
    <_GpuConstants Condition="'$(UseDiscreteGpu)' == 'true'">$(_GpuConstants);USE_DISCRETE_GPU</_GpuConstants>

    <DefineConstants>$(DefineConstants);$(_GpuConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Units/Units.csproj" />
    <ProjectReference Include="..\InstanceFinderCore\InstanceFinderCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="BufferManager/" />
  </ItemGroup>

</Project>